# Keep the IMG_9934 photo algorithm; only switch the diagnostic startup view.
CONFIG_PAPERCOLOR_EXPERIMENTAL_LUT=y
CONFIG_PAPERCOLOR_PRIMARY_WHITE_BUDGET=y
CONFIG_PAPERCOLOR_PRIMARY_PEAK_PRESERVATION=y
CONFIG_PAPERCOLOR_EXACT_PIGMENT_ANCHOR=y
CONFIG_PAPERCOLOR_BLUE_SECONDARY_BALANCE=y
# CONFIG_PAPERCOLOR_NATIVE_CHART_ON_BOOT is not set
# CONFIG_PAPERCOLOR_REFERENCE_PHOTO_ON_BOOT is not set
# CONFIG_PAPERCOLOR_REFERENCE_CHART_ON_BOOT is not set
CONFIG_PAPERCOLOR_MIX_RATIO_CHART_ON_BOOT=y
