{"date": "2020-04-10", "url": "https://img.owspace.com/Public/uploads/Download/2020/0410.jpg", "checked_at": "2026-11-03T02:36:12+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "5cd95b471cb80c6a02d4ee5fa741b14cb050d3fe1bed2e0e7691c67ac1f01dd6", "image_bytes": 188929, "image_format": "jpeg", "last_modified": "Tue, 07 Apr 2020 16:42:11 GMT", "title": "宜突围", "title_kind": "宜", "source": "大河湾", "author": "V.S.奈保尔", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "我仿佛远远地看着这个星球，还有它上面的芸芸众生——他们迷失在时间和空间之中，永不停歇地奔波劳碌，可怕的劳碌，无谓的劳碌。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "V.S.NAIPAUL", "author_name_audit": {"date": "2026-11-03", "method": "visual_attribution_crop", "fields": ["author"], "image_sha256": "5cd95b471cb80c6a02d4ee5fa741b14cb050d3fe1bed2e0e7691c67ac1f01dd6", "note": "原图姓名包含缩写，旧解析丢失字母前缀；已逐张核对补全。"}, "metadata_edits": [{"audit": "author_names_2026-11-03", "changes": {"author": {"before": "奈保尔", "after": "V.S.奈保尔"}}, "evidence_image_sha256": "5cd95b471cb80c6a02d4ee5fa741b14cb050d3fe1bed2e0e7691c67ac1f01dd6"}]}
