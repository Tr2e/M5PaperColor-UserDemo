{"date": "2020-04-15", "url": "https://img.owspace.com/Public/uploads/Download/2020/0415.jpg", "checked_at": "2026-11-03T02:36:14+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "1ee5516eecc5660f5d907ea68cfde51f562203fee1f89743c364b335e5f2caf8", "image_bytes": 177258, "image_format": "jpeg", "last_modified": "Mon, 13 Apr 2020 11:58:11 GMT", "title": "忌逆来顺受", "title_kind": "忌", "source": "房思琪的初恋乐园", "author": "林奕含", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "sample_metadata_verified", "quotation_status": "not_collected", "status": "indexed", "manual_review_fields": ["title", "author", "source"], "source_status": "printed", "author_status": "printed", "excerpt": "忍耐不是美德，把忍耐当成美德是这个伪善的世界维持它扭曲的秩序的方式，生气才是美徳。", "excerpt_ocr_confidence_min": 0.5}
