{"date": "2020-05-13", "url": "https://img.owspace.com/Public/uploads/Download/2020/0513.jpg", "checked_at": "2026-11-03T02:36:21+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "46cc74e82fae09cbd0c515e60261e171e74f9439f76aeff9cbfc2db67ed97dbc", "image_bytes": 168903, "image_format": "jpeg", "last_modified": "Tue, 12 May 2020 00:10:15 GMT", "title": "忌拉黑", "title_kind": "忌", "source": "唯幕", "author": "阿加莎·克里斯蒂", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "在争吵、误解和日常生活中掩盖不住的敌意背后，可能存在着一份真挚的感情。", "excerpt_ocr_confidence_min": 1, "author_foreign_name": "AGATHA CHRISTIE"}
