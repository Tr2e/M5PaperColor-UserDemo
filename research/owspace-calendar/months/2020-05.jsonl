{"date": "2020-05-15", "url": "https://img.owspace.com/Public/uploads/Download/2020/0515.jpg", "checked_at": "2026-11-03T02:36:22+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "b1f906f57e8327cd4bd91a172461c44ffc8f4ac6c4b7388d9130820e9ff06bc4", "image_bytes": 184999, "image_format": "jpeg", "last_modified": "Mon, 11 May 2020 14:56:32 GMT", "title": "宜琴瑟和鸣", "title_kind": "宜", "source": "我们为何结婚，又为何不忠", "author": "海伦-费舍尔", "author_roles": ["人类学家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "如果人类这一物种要存活下去，往后的100万年，我们还是必须坠入爱河，并与对方结为终身伴侣。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "HELEN FISHER"}
