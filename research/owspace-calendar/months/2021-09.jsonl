{"date": "2021-09-07", "url": "https://img.owspace.com/Public/uploads/Download/2021/0907.jpg", "checked_at": "2026-11-03T02:47:34+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "3199dabaa29dcada3df3bbc7c456df82bd8dd2c24c334010b70ac6efcf8f7daa", "image_bytes": 127233, "image_format": "jpeg", "last_modified": "Sun, 05 Sep 2021 23:56:50 GMT", "title": "宜野生", "title_kind": "宜", "source": "从凶险和泥泞的沼译中", "author": "奥西普·曼德尔施塔姆", "author_roles": ["诗人"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "我悄悄长大，像芦苇般沙沙有声，既迷恋，懒散，又温情地呼吸着被禁止的生命。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "Osip Mandelstam"}
