{"date": "2020-03-26", "url": "https://img.owspace.com/Public/uploads/Download/2020/0326.jpg", "checked_at": "2026-11-03T02:36:08+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "01d50219f49a58ab365f6d069b8457779458d22a9bbe6e97006b9df74520a266", "image_bytes": 171674, "image_format": "jpeg", "last_modified": "Mon, 23 Mar 2020 15:22:38 GMT", "title": "忌逢迎", "title_kind": "忌", "source": "牯岭街少年杀人案", "author": "杨德昌", "author_roles": ["导演"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "如果一个人要为他没犯的错去道歉，去讨好的话，这种人，什么事做不出来啊！", "excerpt_ocr_confidence_min": 0.5}
{"date": "2020-03-27", "url": "https://img.owspace.com/Public/uploads/Download/2020/0327.jpg", "checked_at": "2026-11-03T02:36:08+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "5305886e191e4aaea825351c4f1c625d6a3dcfde64bdd856c62d6b7dfcec71e2", "image_bytes": 159906, "image_format": "jpeg", "last_modified": "Mon, 23 Mar 2020 15:22:39 GMT", "title": "宜装糊涂", "title_kind": "宜", "source": "动物凶猛", "author": "王朔", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "人都是顽固不化和自以为是的，相安无事的唯一办法就是欺骗。", "excerpt_ocr_confidence_min": 1}
{"date": "2020-03-28", "url": "https://img.owspace.com/Public/uploads/Download/2020/0328.jpg", "checked_at": "2026-11-03T02:36:08+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "b425b71ca3683dd48a980d39199a05fb1d0d18b7db72caa2358da6d760122ace", "image_bytes": 165893, "image_format": "jpeg", "last_modified": "Tue, 24 Mar 2020 00:31:28 GMT", "title": "忌以己度人", "title_kind": "忌", "source": "东京物语", "author": "小津安二郎", "author_roles": ["导演"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "—等你老了，一个人就会很寂寞。—没关系，我不会让自己老的。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "YASUJIRO OZU"}
