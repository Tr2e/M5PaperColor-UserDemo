{"date": "2015-09-18", "url": "https://img.owspace.com/Public/uploads/Download/2015/0918.jpg", "checked_at": "2026-11-03T02:13:04+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "139aba301e9a8d4587c17b261212ccf3b841ec3d70e3461e04b0fc9f32e53d9d", "image_bytes": 74210, "last_modified": "Wed, 14 Sep 2016 06:44:47 GMT", "title": "宜守候", "title_kind": "宜", "source": "如果人能说出", "author": "塞尔努达", "author_roles": [], "ocr_confidence_min": 0.3, "review_flags": ["low_ocr_confidence"], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "我的存在由你决定：如果不认识你，我没有活过；如果不认识你就死，我不会死，因头我还没活过。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "Cernuda"}
