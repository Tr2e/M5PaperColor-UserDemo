{"date": "2021-08-28", "url": "https://img.owspace.com/Public/uploads/Download/2021/0828.jpg", "checked_at": "2026-11-03T02:47:31+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "f54af47be97c6dc60114ff1454810519679db3de9cd9c785088fc1be172d6ed7", "image_bytes": 168611, "image_format": "jpeg", "last_modified": "Sun, 22 Aug 2021 16:23:32 GMT", "title": "宜赴约", "title_kind": "宜", "source": "少年雏特的烦恼", "author": "约翰·沃尔夫冈·冯·歌德", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "早晨我醒来，怀着无比的喜悦观望美丽的太阳，喊出声来：“我要去看她！”一整天我别无他求。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "Johann Wolfgang von Goethe"}
