{"date": "2021-08-26", "url": "https://img.owspace.com/Public/uploads/Download/2021/0826.jpg", "checked_at": "2026-11-03T02:47:30+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "e989a2c57cae7dbd8d649a378901e6e92d48c4344a89fa28f914067d61ce885f", "image_bytes": 160057, "image_format": "jpeg", "last_modified": "Sun, 22 Aug 2021 16:23:32 GMT", "title": "忌疲劳驾驶", "title_kind": "忌", "source": "南方高速", "author": "胡里奥·科塔萨尔", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "在夜间公路上置身于陌生的车辆之中，彼此间一无所有，所有人都直直地目视前方，唯有前方。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "Julio Cortazar"}
