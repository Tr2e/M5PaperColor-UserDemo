{"date": "2015-08-26", "url": "https://img.owspace.com/Public/uploads/Download/2015/0826.jpg", "checked_at": "2026-11-03T02:12:58+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "917747a14606d0fee75ecba67d0a267220baec66b1beff5a341d7050400dac2f", "image_bytes": 63060, "last_modified": "Wed, 14 Sep 2016 12:30:35 GMT", "title": "忌反复", "title_kind": "忌", "source": "旺角卡门", "author": "王家卫", "author_roles": [], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "你不要说两次，说两次我就相信了。", "excerpt_ocr_confidence_min": 1}
{"date": "2015-08-27", "url": "https://img.owspace.com/Public/uploads/Download/2015/0827.jpg", "checked_at": "2026-11-03T02:12:58+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "a7edff2613e523958fb1c94c77643a838aa041c49270a3ab5991cabd97b1b6a6", "image_bytes": 78115, "last_modified": "Wed, 14 Sep 2016 12:30:34 GMT", "title": "宜沉沦", "title_kind": "宜", "source": "荒人手记", "author": "朱天文", "author_roles": [], "ocr_confidence_min": 0.3, "review_flags": ["low_ocr_confidence"], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "在我之上，从黑暗到光亮，人欲纵横，色欲驰骋。在我之下，除了深渊还是深渊。", "excerpt_ocr_confidence_min": 0.5}
{"date": "2015-08-28", "url": "https://img.owspace.com/Public/uploads/Download/2015/0828.jpg", "checked_at": "2026-11-03T02:12:58+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "b79e1416ca388b19589721641ed3778d5c1a2a34ff06633e3a7b5f2e72fec325", "image_bytes": 67676, "last_modified": "Tue, 13 Sep 2016 09:32:33 GMT", "title": "忌出卖", "title_kind": "忌", "source": "浮士德", "author": "歌德", "author_roles": [], "ocr_confidence_min": 0.3, "review_flags": ["low_ocr_confidence"], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "就算要出卖灵魂，也要找个付得起价钱的人。", "excerpt_ocr_confidence_min": 1, "author_foreign_name": "Goethe", "author_name_audit": {"date": "2026-11-03", "method": "visual_attribution_crop", "fields": ["author_foreign_name"], "image_sha256": "b79e1416ca388b19589721641ed3778d5c1a2a34ff06633e3a7b5f2e72fec325", "note": "重新对照原图外文署名；保留原图拼写。"}, "metadata_edits": [{"audit": "author_names_2026-11-03", "changes": {"author_foreign_name": {"before": "Coethe", "after": "Goethe"}}, "evidence_image_sha256": "b79e1416ca388b19589721641ed3778d5c1a2a34ff06633e3a7b5f2e72fec325"}]}
