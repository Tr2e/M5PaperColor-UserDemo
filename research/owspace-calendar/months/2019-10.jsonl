{"date": "2019-10-06", "url": "https://img.owspace.com/Public/uploads/Download/2019/1006.jpg", "checked_at": "2026-11-03T02:32:57+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "d1c07d960885b8732195fb5eed5eae6dce36b59642b5509d236f447bb136ca8d", "image_bytes": 123309, "image_format": "jpeg", "last_modified": "Mon, 30 Sep 2019 10:37:36 GMT", "title": "宜慵懒", "title_kind": "宜", "source": "唯有孤独恒常如新", "author": "伊丽莎白·毕肖普", "author_roles": ["诗人"], "ocr_confidence_min": 0.3, "review_flags": ["low_ocr_confidence"], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "既然天空也会同样恒久地照看我们，亲爱的朋友，你一直匆匆忙忙，讲求实际；来看看发生了什么。因为时光若不服从我们，便是虚掷。", "excerpt_ocr_confidence_min": 1, "author_foreign_name": "ELIZABETH BISHOP", "author_name_audit": {"date": "2026-11-03", "method": "visual_attribution_crop", "fields": ["author_foreign_name"], "image_sha256": "d1c07d960885b8732195fb5eed5eae6dce36b59642b5509d236f447bb136ca8d", "note": "重新对照原图外文署名；保留原图拼写。"}, "metadata_edits": [{"audit": "author_names_2026-11-03", "changes": {"author_foreign_name": {"before": "RLZABRTH BISHOP", "after": "ELIZABETH BISHOP"}}, "evidence_image_sha256": "d1c07d960885b8732195fb5eed5eae6dce36b59642b5509d236f447bb136ca8d"}]}
{"date": "2019-10-07", "url": "https://img.owspace.com/Public/uploads/Download/2019/1007.jpg", "checked_at": "2026-11-03T02:32:57+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "e7c092a7f89ed45f158f383efd30e3cc50485a47f071700f9569f4ef34f6327a", "image_bytes": 100793, "image_format": "jpeg", "last_modified": "Mon, 30 Sep 2019 10:37:37 GMT", "title": "忌悲观主义", "title_kind": "忌", "source": "小团圆", "author": "张爱玲", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "人生是残酷的。看到我们缩小又缩小的，怯怯的愿望，我总觉得有无限的惨伤。", "excerpt_ocr_confidence_min": 1}
{"date": "2019-10-08", "url": "https://img.owspace.com/Public/uploads/Download/2019/1008.jpg", "checked_at": "2026-11-03T02:32:57+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "d9900e618f4dabc9a3a9e32176b56dc4361e9c37c99d6c753fae8f6346ac54dc", "image_bytes": 95801, "image_format": "jpeg", "last_modified": "Mon, 30 Sep 2019 10:37:38 GMT", "title": "宜朝九晚五", "title_kind": "宜", "source": "马雁散文集", "author": "马雁", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "虚无是不好的。应该有一个工作，每天劳动、吵架和甜蜜。", "excerpt_ocr_confidence_min": 1}
{"date": "2019-10-09", "url": "https://img.owspace.com/Public/uploads/Download/2019/1009.jpg", "checked_at": "2026-11-03T02:32:58+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "b238f4fa99ed22bf7faab3a27e16e693aaf5135892779aa77aea355b1eb5f687", "image_bytes": 102730, "image_format": "jpeg", "last_modified": "Tue, 08 Oct 2019 10:08:45 GMT", "title": "宜牵挂", "title_kind": "宜", "source": "江陵愁望寄子安", "author": "鱼玄机", "author_roles": ["诗人"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "枫叶千枝复万枝，江桥掩映暮帆迟。忆君心似西江水，日夜东流无歇时。", "excerpt_ocr_confidence_min": 1}
{"date": "2019-10-10", "url": "https://img.owspace.com/Public/uploads/Download/2019/1010.jpg", "checked_at": "2026-11-03T02:32:58+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "727d69776b9c4e01233205936def0909e0aecbd59910250e66e7cd41e666a027", "image_bytes": 117984, "image_format": "jpeg", "last_modified": "Tue, 08 Oct 2019 10:08:45 GMT", "title": "宜鬼魅", "title_kind": "宜", "source": "星辰时刻", "author": "克拉丽丝·李斯佩克朵", "author_roles": ["作家"], "ocr_confidence_min": 0.3, "review_flags": ["low_ocr_confidence"], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "我的快乐也来自我最深的悲伤，悲伤是一种未遂的快乐。是的，在她的神经症里，她微微地快乐。打仗一般的神经症。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "CLARICE LISPECTOR"}
{"date": "2019-10-11", "url": "https://img.owspace.com/Public/uploads/Download/2019/1011.jpg", "checked_at": "2026-11-03T02:32:58+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "2a57e1596a75fa292535845749b062aba9df522b02a49b65f8d70e41354f3c55", "image_bytes": 92068, "image_format": "jpeg", "last_modified": "Tue, 08 Oct 2019 10:08:46 GMT", "title": "宜FREESTYLE", "title_kind": "宜", "source": "西方哲学史", "author": "罗素", "author_roles": ["哲学家"], "ocr_confidence_min": 0.3, "review_flags": ["low_ocr_confidence", "source_name_suspect"], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "参差多态，才是幸福之本源，但这乌托邦中几乎丝毫不见。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "CRUSSELL", "author_name_audit": {"date": "2026-11-03", "method": "visual_attribution_crop", "fields": ["author_foreign_name"], "image_sha256": "2a57e1596a75fa292535845749b062aba9df522b02a49b65f8d70e41354f3c55", "note": "原图印为 CRUSSELL，保留原图拼写。"}, "metadata_edits": [{"audit": "author_names_2026-11-03", "changes": {"author_foreign_name": {"before": "CRUSSBLL", "after": "CRUSSELL"}}, "evidence_image_sha256": "2a57e1596a75fa292535845749b062aba9df522b02a49b65f8d70e41354f3c55"}]}
{"date": "2019-10-12", "url": "https://img.owspace.com/Public/uploads/Download/2019/1012.jpg", "checked_at": "2026-11-03T02:32:59+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "5ccbad0109588292409ca9221c8d11c73c423f1072be627de9919cec0ee85778", "image_bytes": 105075, "image_format": "jpeg", "last_modified": "Tue, 08 Oct 2019 10:08:47 GMT", "title": "忌媚俗", "title_kind": "忌", "source": "远处的拉莫", "author": "胡迁", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "很久之前，我就告诉自己不能被任何事物所击垮，只要有一瞬间的崩塌，便会迅速瓦解。", "excerpt_ocr_confidence_min": 0.5}
{"date": "2019-10-13", "url": "https://img.owspace.com/Public/uploads/Download/2019/1013.jpg", "checked_at": "2026-11-03T02:32:59+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "f573aff7eadf6ee4c1bbaf0a41ae56178deeeac62a946aa85f27f58a42891f4e", "image_bytes": 91657, "image_format": "jpeg", "last_modified": "Sat, 12 Oct 2019 05:40:34 GMT", "title": "忌真情实感", "title_kind": "忌", "source": "无欲的悲歌", "author": "彼得．汉德克", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "“自从了解了人，我就爱上了动物。”他说。", "excerpt_ocr_confidence_min": 0.5}
