{"date": "2019-10-15", "url": "https://img.owspace.com/Public/uploads/Download/2019/1015.jpg", "checked_at": "2026-11-03T02:32:59+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "126dd9ffd868965e2234839e43684e01125800dc2b1adb32cd6768a97685acf9", "image_bytes": 109327, "image_format": "jpeg", "last_modified": "Mon, 14 Oct 2019 08:01:04 GMT", "title": "宜阴晴不定", "title_kind": "宜", "source": "更多的人死于心碎", "author": "索尔·贝娄", "author_roles": ["作家"], "ocr_confidence_min": 0.3, "review_flags": [], "review_status": "sample_metadata_verified", "quotation_status": "not_collected", "status": "indexed", "manual_review_fields": ["title", "author", "source"], "source_status": "printed", "author_status": "printed", "excerpt": "我这个人对天气特别敏感，气候左右着我的情绪，时而兴高采烈，时而灰心丧气，一切皆决定于天气。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "SAUL BELLOW", "author_name_audit": {"date": "2026-11-03", "method": "visual_attribution_crop", "fields": ["author_foreign_name"], "image_sha256": "126dd9ffd868965e2234839e43684e01125800dc2b1adb32cd6768a97685acf9", "note": "重新对照原图外文署名；保留原图拼写。"}, "metadata_edits": [{"audit": "author_names_2026-11-03", "changes": {"author_foreign_name": {"before": "SAUL BBILI.OW", "after": "SAUL BELLOW"}}, "evidence_image_sha256": "126dd9ffd868965e2234839e43684e01125800dc2b1adb32cd6768a97685acf9"}]}
{"date": "2019-10-16", "url": "https://img.owspace.com/Public/uploads/Download/2019/1016.jpg", "checked_at": "2026-11-03T02:33:00+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "78dde6ef1ac9842ea60ebfc914ddd10e9e45d82d2e419b7946c4403424abbb39", "image_bytes": 113498, "image_format": "jpeg", "last_modified": "Mon, 14 Oct 2019 13:06:07 GMT", "title": "宜破釜沉舟", "title_kind": "宜", "source": "自由", "author": "乔纳森·弗兰岑", "author_roles": ["作家"], "ocr_confidence_min": 0.3, "review_flags": ["low_ocr_confidence"], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "有些日子就是如此之糟，只有让它们变得更糟，一头扎入坏消息的海洋，才能拯救它们。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "JONATHAN FRANZEN", "author_name_audit": {"date": "2026-11-03", "method": "visual_attribution_crop", "fields": ["author_foreign_name"], "image_sha256": "78dde6ef1ac9842ea60ebfc914ddd10e9e45d82d2e419b7946c4403424abbb39", "note": "重新对照原图外文署名；保留原图拼写。"}, "metadata_edits": [{"audit": "author_names_2026-11-03", "changes": {"author_foreign_name": {"before": "JONATHAN PRANZEN", "after": "JONATHAN FRANZEN"}}, "evidence_image_sha256": "78dde6ef1ac9842ea60ebfc914ddd10e9e45d82d2e419b7946c4403424abbb39"}]}
{"date": "2019-10-17", "url": "https://img.owspace.com/Public/uploads/Download/2019/1017.jpg", "checked_at": "2026-11-03T02:33:00+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "eb45832173003ba24a468ee742381980144a1e0c9d156cfcbaef56ae104c2a76", "image_bytes": 111777, "image_format": "jpeg", "last_modified": "Mon, 14 Oct 2019 17:19:37 GMT", "title": "忌一叶障目", "title_kind": "忌", "source": "小城畸人", "author": "舍伍德·安德森", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "一个人一旦为自己掌握了一个真理，称之为他的真理，并且努力依此真理过他的生活时，他便变成了畸人，他拥抱的真理便变成了虚妄。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "SHERWOOD ANDERSON"}
