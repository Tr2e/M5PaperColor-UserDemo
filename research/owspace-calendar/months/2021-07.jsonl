{"date": "2021-07-19", "url": "https://img.owspace.com/Public/uploads/Download/2021/0719.jpg", "checked_at": "2026-11-03T02:47:20+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "f960dae83b0c2501824daa71de09b27695c1197fe275b34104b0384068353d4a", "image_bytes": 129589, "image_format": "jpeg", "last_modified": "Sun, 18 Jul 2021 14:53:20 GMT", "title": "宜遥想", "title_kind": "宜", "source": "尘埃落定", "author": "阿来", "author_roles": ["作家"], "ocr_confidence_min": 1, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "她对着我的脸颊亲了一口，带给我好多远处的日子和地方的味道。", "excerpt_ocr_confidence_min": 0.3}
