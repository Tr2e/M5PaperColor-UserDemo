{"date": "2021-07-04", "url": "https://img.owspace.com/Public/uploads/Download/2021/0704.jpg", "checked_at": "2026-11-03T02:47:15+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "1db5ee078f761dcb307ca8627d5639753eb04fccb417452ccb300965f01b46c3", "image_bytes": 131900, "image_format": "jpeg", "last_modified": "Sun, 27 Jun 2021 15:38:32 GMT", "title": "宜放手一搏", "title_kind": "宜", "source": "埃斯库罗斯悲刷六种", "author": "埃斯库罗斯", "author_roles": [], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "未来的事到时便知，现在且随它去吧—预知等于还没有受伤就叫痛—它自会随着黎明清清楚楚地出现。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "Aeschylus", "author_name_audit": {"date": "2026-11-03", "method": "visual_attribution_crop", "fields": ["author"], "image_sha256": "1db5ee078f761dcb307ca8627d5639753eb04fccb417452ccb300965f01b46c3", "note": "对照原图署名区核对。"}, "metadata_edits": [{"audit": "author_names_2026-11-03", "changes": {"author": {"before": "戏剧家，埃斯库罗斯", "after": "埃斯库罗斯"}}, "evidence_image_sha256": "1db5ee078f761dcb307ca8627d5639753eb04fccb417452ccb300965f01b46c3"}]}
