{"date": "2021-07-11", "url": "https://img.owspace.com/Public/uploads/Download/2021/0711.jpg", "checked_at": "2026-11-03T02:47:17+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "2cca251d07d777e9f485f191172aeed8e28d6c30eafa3c18cf671429b2e491ad", "image_bytes": 123222, "image_format": "jpeg", "last_modified": "Sun, 04 Jul 2021 23:06:20 GMT", "title": "忌硬拗", "title_kind": "忌", "source": "荒原狼", "author": "赫尔曼-黑塞", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "我想，所有别人天生就会的事情你都得好好学一学。连吃饭的乐趣也得学。", "excerpt_ocr_confidence_min": 1, "author_foreign_name": "Hermann Hesse"}
{"date": "2021-07-12", "url": "https://img.owspace.com/Public/uploads/Download/2021/0712.jpg", "checked_at": "2026-11-03T02:47:18+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "e5c28f26a820a2f157eb60f266de56a93e32b154822a0ec959c32829733ddbea", "image_bytes": 130667, "image_format": "jpeg", "last_modified": "Sun, 11 Jul 2021 00:10:19 GMT", "title": "宜重启", "title_kind": "宜", "source": "二十首悄诗与绝望的歌", "author": "巴勃罗·聂鲁达", "author_roles": ["诗人"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "我不说“永不”，因为昨天和今天与明天的我并不一样。我以多变化的爱失言真诚。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "Pablo Neruda", "author_name_audit": {"date": "2026-11-03", "method": "visual_attribution_crop", "fields": ["author"], "image_sha256": "e5c28f26a820a2f157eb60f266de56a93e32b154822a0ec959c32829733ddbea", "note": "对照原图署名区核对。"}, "metadata_edits": [{"audit": "author_names_2026-11-03", "changes": {"author": {"before": "巴勤罗·聂鲁达", "after": "巴勃罗·聂鲁达"}}, "evidence_image_sha256": "e5c28f26a820a2f157eb60f266de56a93e32b154822a0ec959c32829733ddbea"}]}
{"date": "2021-07-13", "url": "https://img.owspace.com/Public/uploads/Download/2021/0713.jpg", "checked_at": "2026-11-03T02:47:18+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "5c956efc8d7e054dad1508e0250b7d540287b8d0d5eb021e881137c9fb13f152", "image_bytes": 133027, "image_format": "jpeg", "last_modified": "Sun, 11 Jul 2021 23:48:20 GMT", "title": "忌装睡", "title_kind": "忌", "source": "艺术与催眠", "author": "阿城", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "只要山沟儿里一天没有医，没有药，催眠就是最有效的，巫医就万岁万岁。", "excerpt_ocr_confidence_min": 0.5}
{"date": "2021-07-14", "url": "https://img.owspace.com/Public/uploads/Download/2021/0714.jpg", "checked_at": "2026-11-03T02:47:18+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "6b716f9d41d109c624642b317875d22db2e32bf71f3f1be2dca3dfab248b847a", "image_bytes": 142114, "image_format": "jpeg", "last_modified": "Sun, 11 Jul 2021 23:48:21 GMT", "title": "宜唯我独尊", "title_kind": "宜", "source": "日出", "author": "约翰·多恩", "author_roles": ["诗人"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "你只须照耀我们这儿.光芒就会遍及四方，这张床是你的中心，墻壁是你的穹苍。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "John Donne"}
