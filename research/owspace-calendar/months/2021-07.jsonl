{"date": "2021-07-31", "url": "https://img.owspace.com/Public/uploads/Download/2021/0731.jpg", "checked_at": "2026-11-03T02:47:23+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "42920781d17207897892f147fcfebfea427dcdf71aa5f35112f7768d14fd875b", "image_bytes": 144974, "image_format": "jpeg", "last_modified": "Mon, 26 Jul 2021 00:00:57 GMT", "title": "忌倒数", "title_kind": "忌", "source": "喧哗与骚动", "author": "威廉·福克纳", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "我把表给你，不是要让你记住时间，而是让你可以偶尔忘掉时间，不把心力全部用在征服时间上面。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "William Faulkner"}
