{"date": "2021-07-16", "url": "https://img.owspace.com/Public/uploads/Download/2021/0716.jpg", "checked_at": "2026-11-03T02:47:19+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "1176215d08cf6c2740a86f277f282be33db2ce760d13440d1c881d55ad41ccc1", "image_bytes": 141285, "image_format": "jpeg", "last_modified": "Sun, 11 Jul 2021 23:48:21 GMT", "title": "宜敞亮", "title_kind": "宜", "source": "草原上的小木屋", "author": "罗兰·英格斯·怀德", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "爸爸到西墻上劈开了做窗子的大洞口，阳光哗啦一下就倾泻进来。当爸爸开完新窗口时，阳光已经酒落了一地。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "Laura Ingalls Wilder", "author_name_audit": {"date": "2026-11-03", "method": "visual_attribution_crop", "fields": ["author", "author_foreign_name"], "image_sha256": "1176215d08cf6c2740a86f277f282be33db2ce760d13440d1c881d55ad41ccc1", "note": "对照原图署名区核对。"}, "metadata_edits": [{"audit": "author_names_2026-11-03", "changes": {"author_foreign_name": {"before": "Iaura Ingalls Wilder", "after": "Laura Ingalls Wilder"}}, "evidence_image_sha256": "1176215d08cf6c2740a86f277f282be33db2ce760d13440d1c881d55ad41ccc1"}]}
{"date": "2021-07-17", "url": "https://img.owspace.com/Public/uploads/Download/2021/0717.jpg", "checked_at": "2026-11-03T02:47:19+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "6af1897376393ab1403e6c8338452738a9550fb59d145da6d9c9f2f58f6fdf7f", "image_bytes": 127642, "image_format": "jpeg", "last_modified": "Fri, 16 Jul 2021 00:10:26 GMT", "title": "宜自然醒", "title_kind": "宜", "source": "旅客", "author": "弗拉基米尔-纳博科夫", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "对我而言，世上最迷人的清晨也代替不了上午几个小时的酣睡。", "excerpt_ocr_confidence_min": 0.5, "author_foreign_name": "Vladimir Vladimirovich Nabokov"}
