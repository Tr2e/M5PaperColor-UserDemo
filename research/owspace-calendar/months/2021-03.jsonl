{"date": "2021-03-21", "url": "https://img.owspace.com/Public/uploads/Download/2021/0321.jpg", "checked_at": "2026-11-03T02:46:41+00:00", "http_status": 200, "content_type": "image/jpeg", "image_sha256": "d57f17cd36e4b6bfbd44aa2c1d9bf8e613e95d958b1d9168b969d1888d448f83", "image_bytes": 145200, "image_format": "jpeg", "last_modified": "Mon, 15 Mar 2021 00:04:29 GMT", "title": "宜奔赴", "title_kind": "宜", "source": "东京一年", "author": "蒋方舟", "author_roles": ["作家"], "ocr_confidence_min": 0.5, "review_flags": [], "review_status": "machine_extracted_not_human_verified", "quotation_status": "not_collected", "status": "indexed", "excerpt": "跑下去，跑进春天里，跑进和煦的阳光里。", "excerpt_ocr_confidence_min": 1}
